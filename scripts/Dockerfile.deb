# 构建 Linux .deb 用的镜像：**必须用较老的发行版**。
#
# 原因：deb 里的二进制链接的是构建机的 glibc。在 Ubuntu 24.04/26.04 上构建出的程序
# 会要求 GLIBC_2.39 / 2.43，拿到 Ubuntu 22.04（glibc 2.35）上动态链接器直接拒绝加载，
# GUI 双击表现为「毫无反应」（终端运行才看得到 version `GLIBC_2.39' not found）。
# Ubuntu 22.04 是 Tauri v2 支持的最老发行版之一，按它构建即可覆盖 22.04 及以上。
#
# 由 scripts/build-deb.sh 使用：
#   docker build -t sas-deb-builder:22.04 -f scripts/Dockerfile.deb scripts
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Tauri v2 在 Linux 上的系统依赖 + 打包工具。
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates build-essential pkg-config file patchelf xz-utils \
      libwebkit2gtk-4.1-dev libjavascriptcoregtk-4.1-dev libsoup-3.0-dev \
      libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Node 22：22.04 仓库里的 nodejs 是 12.x，前端（vite 8 / @tauri-apps/cli 2）跑不了。
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Rust stable（装到系统目录，容器内任何用户都能用）。
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable

WORKDIR /work
CMD ["bash"]
