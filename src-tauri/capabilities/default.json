{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "本地内容（设置窗口）的权限：窗口显隐/最小化/拖拽/DevTools + 全部应用命令（含凭据读写）。**只覆盖本地内容**：远程 SAS 页面（https/http）走的是 remote-sites.json 那套最小权限，所以这里不要列 site-* 窗口（多份 capability 是按并集生效的，写上去等于把 core:default 送给远程页面），也不要给 core:window:allow-close —— 站点窗口的关闭语义是「隐藏到托盘」，把 close() 交给页面后会被 prevent_close 吞掉，表现为按钮点了没反应。",
  "windows": ["settings"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "allow-get-config",
    "allow-save-config",
    "allow-open-site",
    "allow-new-site-window",
    "allow-close-site-windows",
    "allow-site-window-counts",
    "allow-hide-settings",
    "allow-set-render-mode",
    "allow-set-ui-theme",
    "allow-set-dev-tools",
    "allow-open-url",
    "allow-show-settings",
    "allow-toggle-frameless",
    "allow-get-credential",
    "allow-save-credential",
    "allow-clear-credential"
  ]
}
