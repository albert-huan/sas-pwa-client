{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "本地内容（设置窗口）的权限：窗口显隐/最小化/拖拽/重载/DevTools + 全部应用命令（含凭据读写）。远程 SAS 页面用的是 remote-sites.json，权限更小。",
  "windows": ["settings", "site-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "allow-get-config",
    "allow-save-config",
    "allow-open-site",
    "allow-new-site-window",
    "allow-close-site-windows",
    "allow-site-window-counts",
    "allow-hide-settings",
    "allow-set-render-mode",
    "allow-show-settings",
    "allow-toggle-frameless",
    "allow-get-credential",
    "allow-save-credential",
    "allow-clear-credential"
  ]
}
